          "name": "Create an API token",
          "request": {
            "name": "Create an API token",
            "description": {
              "content": "Creates a new API token for the authenticated user. The plain-text token is returned once; subsequent reads return a masked version.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "-",
                "npm",
                "v1",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"<password>\",\n  \"readonly\": \"<boolean>\",\n  \"cidr_whitelist\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
