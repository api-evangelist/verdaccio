  "info": {
    "_postman_id": "1ab21a8f-7aaf-4ef1-83de-05887e3f63f0",
    "name": "Verdaccio npm Registry dist-tags tokens API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Verdaccio npm Registry REST API implements the CommonJS Compliant Package Registry specification, providing endpoints to publish, retrieve, search, and delete npm packages. It supports JWT tokens and Basic Auth for authentication and mirrors the standard npm registry protocol so any npm, yarn, or pnpm client can interact with it without modification.\n\n\nContact Support:\n Name: Verdaccio Community",
      "type": "text/plain"
    }
  }
