                  "key": "write",
                  "value": "<boolean>",
                  "description": "When true, returns the manifest for write operations (e.g. unpublish)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "package",
                  "description": "(Required) Package name (may be scoped, e.g. `@scope%2Fpackage`)"
                }
